# Google OAuth web client. Do not commit the client secret JSON.
# On Render, set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET.
# Locally, the app also reads client_secret*.json from this folder or the repo root.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Add this exact URI in Google Cloud Console > Credentials > Authorized redirect URIs.
GOOGLE_REDIRECT_URI=https://contract-extraction-joyy.onrender.com/drive/oauth/callback
# Optional after the first browser login. The callback page shows the refresh token once.
GOOGLE_REFRESH_TOKEN=

# Source folder: https://drive.google.com/drive/folders/1yolAv0AGafMmsdNCtc58Qrk8HHJURysS
GOOGLE_DRIVE_FOLDER_ID=1yolAv0AGafMmsdNCtc58Qrk8HHJURysS

# Supabase project jujvtuyksxkoclegjznb, bucket Contracts.
SUPABASE_URL=https://jujvtuyksxkoclegjznb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=Contracts
# New prefix inside the Contracts bucket. Drive subfolders are copied underneath it.
SUPABASE_UPLOAD_FOLDER=Google Drive

# Run supabase-drive-upload-log.sql once. Sync writes one row per file and folder to contract_drive_uploads.

# Same secret as extraction, if set. Required to start /drive/sync when present.
EXTRACT_TRIGGER_SECRET=
